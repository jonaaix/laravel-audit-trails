{
    "name": "aaix/laravel-audit-trails",
    "description": "Lightweight audit-trail package for Laravel — logs created, updated, deleted, restored and force-deleted Eloquent events.",
    "keywords": [
        "laravel",
        "audit",
        "audit-trail",
        "audit-log",
        "eloquent",
        "observer"
    ],
    "homepage": "https://github.com/jonaaix/laravel-audit-trails",
    "license": "MIT",
    "authors": [
        {
            "name": "jonaaix",
            "email": "jonaaix@icloud.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": ">=11.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": ">=9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Aaix\\LaravelAuditTrails\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aaix\\LaravelAuditTrails\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aaix\\LaravelAuditTrails\\LaravelAuditTrailsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
